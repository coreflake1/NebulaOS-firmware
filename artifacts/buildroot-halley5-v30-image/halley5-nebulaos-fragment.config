# Local additions on top of x2000_halley5_v30_linux_defconfig for the OpenKE
# ke-mainline-klipper Phase 2 rebase. Kept as a real Buildroot config fragment
# (BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES) rather than hand-edited into
# output/build/linux-custom/.config, since that gets wiped on every
# `make linux-reconfigure` - this file is what actually persists.

# Production optimization mission, Phase 12 (2026-07-31): CPU frequency
# scaling/DVFS investigated and explicitly REJECTED - CONFIG_CPU_FREQ
# deliberately stays unset, do not enable without re-reading this first.
# A real vendor driver exists and is properly Kconfig-wired
# (module_drivers/drivers/cpufreq/ingenic-cpufreq.c, CONFIG_X2000_CPUFREQ,
# depends on SOC_X2000 which is already =y) and the legacy `operating-points`
# DT binding this board's DTS uses (halley5_v30.dts's `&cpufreq` node) is
# still parsed by this kernel's OPP core (_of_add_opp_table_v1() in
# drivers/opp/of.c). Rejected anyway on hardware grounds, not driver
# availability: this board has no CPU voltage-scaling hardware at all.
# CONFIG_REGULATOR_FIXED_VOLTAGE is the only regulator driver compiled in
# (no PMIC/variable-voltage driver exists in this kernel); the only
# regulators anywhere in the DTS are three fixed-only camera power rails
# (cam_avdd/dvdd/dovdd, all `compatible = "regulator-fixed"` - GPIO on/off,
# not adjustable); no `cpu-core-supply` property exists anywhere in the
# device tree for the cpufreq node to even reference. The OPP table itself
# already reflects this: every single frequency point from 200MHz to
# 1.2GHz lists the IDENTICAL 900mV - the vendor's own data already
# concedes no real voltage scaling was ever wired up for this board.
# Frequency-only scaling (no voltage change) would still route through
# ingenic-cpufreq.c's regulator handling, which has a real, unfixed bug -
# `devm_regulator_get()` returns an ERR_PTR on failure, but the driver
# checks `if (!ingenic_cpufreq->regulator)` (a NULL check), so a missing-
# regulator failure would not be caught cleanly and could feed an invalid
# pointer into later regulator_set_voltage() calls during a real frequency
# transition - undefined, unverified behavior to risk on a live
# motion-control system for a feature whose entire benefit case (voltage
# scaling) is already known to be zero on this specific board. Not tested
# on real hardware - this conclusion is fully supported by static
# driver/DTS/Kconfig analysis alone, no live risk needed to reach it.

# Root filesystem format (2026-07-21, FIRMWARE.md sec 32): CONFIG_SQUASHFS was never
# enabled - Buildroot's BR2_TARGET_ROOTFS_SQUASHFS only controls how the *rootfs image*
# gets built, it does not touch the kernel's own .config at all, so the kernel had zero
# squashfs filesystem driver support even though every rootfs image we've ever produced is
# squashfs. Found via a real boot test, first ever real hardware attempt to get this far:
# msc0 (eMMC) + i2c4 pinctrl fixes got all the way to a real "VFS: Cannot open root
# device /dev/mmcblk0p8 ... error -19" kernel panic - the partition itself was found and
# enumerated correctly (real proof msc0 works), it just had no filesystem driver capable
# of mounting it.
CONFIG_SQUASHFS=y

# Production optimization mission, Phase 10 (2026-07-30): adds ZSTD
# decompression support alongside the existing default ZLIB, so this one
# kernel binary can mount either a gzip or a zstd rootfs.squashfs image -
# needed to A/B compare the two on real hardware via a plain reboot
# between images, without also changing the kernel under test. A
# build-host-only comparison (identical userspace content, three
# mksquashfs -comp variants) already ruled out LZ4 outright (32% larger
# than gzip on this content - the opposite of the goal) and found zstd
# produces a smaller image than gzip; this addition lets that promising
# result be checked for real against actual mount/boot behavior. These
# are independent bool options in fs/squashfs/Kconfig (each just
# `depends on SQUASHFS`), not a mutually-exclusive choice, so enabling
# both is safe. Once one codec is chosen for production, drop the
# decompressor for the other in the final Phase 13 build - shipping both
# forever would be needless kernel surface for a choice already made.
CONFIG_SQUASHFS_ZSTD=y

# USB flash storage (2026-07-26, USB/webcam stock-parity mission): a real
# USB flash drive plugged into this exact device enumerates correctly
# (usb-storage binds, SCSI disk /dev/sda appears with real capacity) using
# only the already-enabled CONFIG_USB_STORAGE/CONFIG_SCSI/CONFIG_BLK_DEV_SD -
# but its actual filesystem is exFAT (confirmed via the boot-sector "EXFAT"
# OEM signature, no partition table - a superfloppy layout), and
# /proc/filesystems had no "exfat" entry at all. CONFIG_VFAT_FS was already
# on, so FAT32 drives already worked; this specific drive just happens to be
# formatted exFAT (a common choice for drives >32GB). Mainline's own exfat
# driver (merged since 5.4, not FUSE-based) - just needed enabling.
CONFIG_EXFAT_FS=y

# WiFi: mainline brcmfmac (SDIO), real chip confirmed live: Cypress CYW43438.
CONFIG_WLAN_VENDOR_BROADCOM=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_PROTO_BCDC=y

# OpenKE (2026-07-22, FIRMWARE.md sec 53): CONFIG_BRCMFMAC=y (built-in, not a
# module - see below) means brcmfmac's own firmware_class request happens
# synchronously during the same early-boot late_initcall window
# openke_wifi_manual_insert() uses to force the manual SDIO insert (sec 46) -
# real hardware confirmed this runs at kernel time ~2.4s, a good 1.5s BEFORE
# "VFS: Mounted root (squashfs filesystem)" (~4.0s). request_firmware() has no
# real rootfs to search yet at that point, no matter how correctly the actual
# files are packaged into rootfs.squashfs (verified independently, byte for
# byte, via unsquashfs on the built image) - confirmed by the exact same
# "Direct firmware load ... failed with error -2" either way. Embedding the
# firmware directly in the kernel image via CONFIG_EXTRA_FIRMWARE sidesteps
# the rootfs-timing question entirely, without touching the early-manual-
# insert timing itself (a separate, already-hard-won fix - sec 46/49).
# CONFIG_EXTRA_FIRMWARE_DIR points at this repo's own overlay content, always
# present under /src (this project's own BUILDROOT_DIR mount point) by the
# time 03-build-kernel-and-rootfs.sh's kernel build step runs, since
# 02-configure-buildroot.sh always syncs scripts/build/overlay/ there first.
# The two files themselves are never committed to this repo (see .gitignore
# and scripts/firmware/fetch-cyw43430-wifi-firmware.sh) - proprietary
# Cypress/Broadcom-format binaries, fetched and hash-verified at build time.
#
# Longer-term alternative worth considering once this whole path is proven
# working end to end: build CONFIG_BRCMFMAC=m instead (a loadable module),
# which the kernel's own SDIO bus autoloads via the standard MODALIAS
# mechanism once userspace/modprobe are available - the normal way mainline
# distros handle this exact "protocol driver needs a mounted rootfs for its
# firmware" situation. Not done here to avoid changing two things (firmware
# packaging AND driver-loading architecture) in the same real-hardware test.
# 2026-07-23 (boot-cleanup audit): the same rootfs-not-mounted-yet timing
# applies to the halley5 board-specific brcmfmac alias, requested at t=2.30s,
# well before "VFS: Mounted root" (t=3.87s) - "failed with error -2" even
# though the symlink is genuinely present in rootfs.squashfs (verified via
# unsquashfs). Same fix, same reason: bake it into the kernel image too, not
# just the rootfs. The generic brcmfmac43430-sdio.bin/.txt files already
# worked this way (see the comment above this one).
#
# 2026-07-23 (boot-cleanup audit, Phase 5b): regulatory.db/.p7s have the
# identical rootfs-not-mounted-yet timing problem (requested at t=1.60s, also
# before root mount) - the previous pass left these out because they didn't
# exist anywhere under this overlay tree at kernel-build time (they're
# installed straight into Buildroot's own TARGET_DIR by the wireless-regdb
# package, a separate build step CONFIG_EXTRA_FIRMWARE_DIR doesn't point at).
# scripts/firmware/fetch-wireless-regdb.sh now stages a real, hash-verified
# copy of the exact same upstream release Buildroot's own package pins
# directly under this overlay's lib/firmware/, closing that gap - run it
# before 03-build-kernel-and-rootfs.sh (gitignored, not committed - see
# .gitignore's own comment for why, same reasoning as the brcm/ firmware).
# The rootfs copy (BR2_PACKAGE_WIRELESS_REGDB) stays enabled too, for any
# later re-request after boot.
# 2026-08-09 (WiFi .125 promotion): CLM blob entry, added during the
# WIFI-FW-125 engineering test (a first attempt, commit 2274450, paired
# this with a mismatched CLM and regressed - see docs/
# NEBULAOS_WIFI_125_ENGINEERING_TEST.md's full incident writeup and
# correction) and now permanent: scripts/build/overlay/lib/firmware/brcm/
# brcmfmac43430-sdio.clm_blob is staged by
# scripts/firmware/fetch-cyw43430-wifi-firmware.sh with 7.45.98.125's own
# matching Infineon CLM, the exact combination live-qualified on real
# hardware before this promotion.
CONFIG_EXTRA_FIRMWARE="brcm/brcmfmac43430-sdio.bin brcm/brcmfmac43430-sdio.txt brcm/brcmfmac43430-sdio.ingenic,halley5.bin brcm/brcmfmac43430-sdio.clm_blob regulatory.db regulatory.db.p7s"
CONFIG_EXTRA_FIRMWARE_DIR="/src/board/halley5-nebulaos-overlay/lib/firmware"

# 2026-07-22 (FIRMWARE.md sec 52): sec 47's "msc1 was bound to the wrong driver
# entirely" finding is REVERSED - disassembling stock's own live, working soc_msc.ko
# (not just cywdhd.ko) proved stock's real msc1 driver IS sdhci-ingenic.c: genuine
# sdhci_ingenic_probe/sdhci_ingenic_set_clock symbols calling real sdhci_add_host(),
# PLUS its own real, exported jzmmc_clk_ctrl/jzmmc_manual_detect - the same two names
# found in cywdhd.ko's disassembly that originally (wrongly) pointed at ingenic_mmc.c.
# ingenic_mmc.c is a separate, unrelated MSC-register-model driver that happens to
# ALSO define functions with these names - never stock's actual msc1 driver at all.
# Our own sdhci-ingenic.c already has the matching architecture (cd_type==
# SDHCI_INGENIC_CD_PERMANENT from "non-removable" sets MMC_CAP_NONREMOVABLE +
# SDHCI_QUIRK_BROKEN_CARD_DETECTION at probe time; its manual-detect function flips
# SDHCI_DEVICE_DEAD and calls mmc_detect_change()) - msc1 reverted to the base
# "ingenic,sdhci" compatible, so nothing needs ingenic_mmc.c anymore. Disabled
# entirely (not just the MMC1 instance) so sdhci-ingenic.c's manual_detect/clk_ctrl
# functions can be renamed back to their original ingenic_mmc_manual_detect/
# ingenic_mmc_clk_ctrl names (undoing sec 47's rename) without recreating the
# multiple-definition link collision that rename existed to fix - ingenic_sdio.c's
# glue calls those exact literal names, and only one driver defining them now.
# CONFIG_INGENIC_MMC is not set

# 2026-07-21: switched from =m to =y (built-in), same reasoning as the
# ns2009/display/RNG conversions - after ruling out both the BCMDHD conflict
# and busybox itself (a trivial fully-static diagnostic binary, built with
# the exact same toolchain, hit the identical "kmod busy with 50 threads" /
# exec failure - see scripts/build/diag_init.c), this is the one remaining
# `=m` driver with real, always-present, always-enumerating onboard hardware
# behind it (the SDIO WiFi chip is a fixed, non-removable card per the DTS).
# The other two remaining `=m` drivers were checked and ruled out as live
# contributors for THIS device/session: USB_NET_AX88179_178A/USB_USBNET have
# no real external dongle attached in any capture (the only USB device seen
# is idVendor=1d6b/idProduct=0002 - the DWC OTG controller's own internal
# root hub, confirmed via its own "Manufacturer: Linux ... dwc2_hsotg"
# string, not real hardware); BT_HCIUART is a tty line discipline, only
# loaded via a userspace ioctl(TIOCSETD) call (hciattach/btattach-style),
# never kernel/hotplug-autoloaded, and nothing ever reaches userspace before
# the panic anyway. Left as modules since neither is implicated.
CONFIG_BRCMFMAC=y

# 2026-07-21: the vendor base defconfig (x2000_halley5_v30_linux) ships its own
# out-of-tree proprietary Broadcom "DHD" driver enabled BUILT-IN
# (module_drivers/drivers/net/wireless/bcmdhd_101_10_591_x/), targeting the
# vendor reference board's own WiFi module (CONFIG_BCMDHD_FW_PATH points at
# fw_bcm43456c5_ag.bin / nvram_ap6256.txt - a BCM43456/AP6256 chip). That is
# NOT our hardware - our real, live-confirmed chip is a Cypress CYW43438 -
# and nobody ever disabled this when brcmfmac was added on top. Being =y, it
# initializes unconditionally very early in boot and, per a real captured
# boot log (vendor/device-backups/wdt-fix-boot-attempt.log), power-cycles
# WL_REG_ON in a tight retry loop ("[dhd] wifi_platform_set_power" /
# "Card detection to remove/detect SDIO card!" every ~2-3s) since it can
# never find its chip/firmware - directly preceding, and very likely
# contributing to, the "kmod busy with 50 threads" / "Requested init
# /linuxrc failed (error -8)" boot panic. Two competing drivers fighting
# over the same SDIO/GPIO hardware was never intentional - disable the
# wrong one entirely.
# CONFIG_BCMDHD is not set

# 2026-07-21: same bug class as BCMDHD above, found via a real boot log
# (vendor/device-backups/custom-boot-brcmfmac-builtin-*.log) after BRCMFMAC=y
# pushed the "kmod busy with 50 threads" panic later (20-25s) but didn't fully
# resolve it. The vendor base defconfig also ships two more reference-board
# peripherals we don't have, both enabled by default and never disabled:
# - CONFIG_TOUCHSCREEN_GT9XX (Goodix touch) - not our hardware, our real touch
#   is NS2009 (already correctly enabled above). Its own I2C probe took ~0.74s
#   (743582 usecs) retrying 3 times against a NOACK address before failing.
# - CONFIG_HALLEY5_CAMERA_BOARD (+ CONFIG_RD_X2000_HALLEY5_CAMERA_4V3, which
#   `select`s CONFIG_INGENIC_ISP_CAMERA_OV2735A) - a vendor reference camera
#   daughterboard we don't have; our real camera is a generic USB UVC webcam
#   via ustreamer, not this native ISP/CSI/MSCaler/VIC pipeline at all. Its
#   own I2C probe took a full ~10 SECONDS (10035626 usecs) waiting out an
#   ABRT_7B_ADDR_NOACK timeout before failing - a real, measurable chunk of
#   boot time, and plausibly a real contributor to the kmod-thread-pool
#   pressure (deferred-probe retries, regulator/GPIO lookups during its own
#   probe attempt) even though its own probe eventually completes rather than
#   hanging outright. Disabling the top-level HALLEY5_CAMERA_BOARD menu gate
#   cascades to clear RD_X2000_HALLEY5_CAMERA_4V3 and OV2735A automatically
#   (confirmed via their real Kconfig `depends on`/`select` chain).
# CONFIG_TOUCHSCREEN_GT9XX is not set
# CONFIG_HALLEY5_CAMERA_BOARD is not set
#
# Disabling the board gate alone did NOT cascade-clear OV2735A (verified via
# the actual built .config, not assumed) - this vendor tree defines/selects
# INGENIC_ISP_CAMERA_OV2735A from at least two overlapping camera-pipeline
# Kconfig trees (media/i2c/ingenic-isp and media/platform/ingenic-isp), so
# disabling it directly rather than relying on the select chain resolving.
# CONFIG_INGENIC_ISP_CAMERA_OV2735A is not set

# Bluetooth: H5/three-wire (matches the original device's own module name,
# hci_uart_h5_kernel_4_4_94.ko, and confirmed via the real board DTS that this
# UART has no hardware RTS/CTS wiring - halley5_v30.dts selects the 2-pin
# uart3_pc pinmux group, not the 4-pin uart3_pd group with flow control, so H4
# was never actually viable here). Stock CONFIG_BT_HCIUART_BCM only works over
# H4 (it selects BT_HCIUART_H4) - CONFIG_BT_HCIUART_BCM_H5 is a real, new
# OpenKE addition (drivers/bluetooth/hci_h5.c) that wires the same
# btbcm_initialize()/btbcm_finalize() firmware-loading calls into H5 instead,
# following the same h5_vnd pattern the existing Realtek support already uses.
# UNTESTED against real hardware - see FIRMWARE.md.
CONFIG_BT=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_BCM_H5=y

# Touch: NS2009 driver (ported from Icenowy Zheng's real GPLv2 driver, see
# artifacts/ns2009-driver/). The whole touchscreen subsystem menu is off by
# default in this defconfig.
#
# 2026-07-21, FIRMWARE.md sec 34: switched from =m to =y (built-in). Real boot
# tests traced a silent init-launch reset all the way to a genuine kernel
# panic (via an init=/bin/sh diagnostic): "Requested init /bin/sh failed
# (error -8)" preceded by "kmod busy with 50 threads for more than 5 seconds
# now". This is a small, single-purpose driver for fixed, always-present
# hardware - no real benefit to it needing request_module() autoload on every
# boot, only downside (one more concurrent kmod consumer at the exact moment
# init tries to exec).
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_NS2009=y

# Display: best-effort panel driver for the real 480x272 panel (timing values
# not confirmed against a real datasheet, see the driver's own header comment
# and FIRMWARE.md). CONFIG_FB_INGENIC_STAGE/CONFIG_FB_INGENIC are already on
# by default in this defconfig - this just adds our new panel to the mix.
# Switched to built-in 2026-07-21 for the same kmod-exhaustion reason as
# NS2009 above.
CONFIG_STAGE_OPENKE_GENERAL_480X272=y

# Diagnostic-only, for the display-quality mission (ke-mainline-klipper):
# exposes the DPU driver's own existing dbg_irqcnt counters (tft_under,
# wdma_over, etc. - already unconditionally incremented in the real ISR,
# see dpu_ctrl.c dpu_ctrl_irq_handler) via a read-only sysfs attribute
# group (dump_irqcnts) at /sys/devices/platform/.../13050000.dpu/. Adds
# no new code, changes no hardware behavior - just turns on a real,
# vendor-provided read-only debug sysfs node that was already compiled
# out. Safe to leave on permanently; not a fix, purely observational.
CONFIG_FB_INGENIC_DUMP=y
#
# 2026-07-21, FIRMWARE.md sec 35: the base defconfig also left CONFIG_STAGE_ZC50289HSHD02=y
# enabled - a second, wrong MIPI-DSI panel driver (a Fitipower vendor reference panel, not our
# hardware). Not inert: halley5_v30.dts conditionally includes a real DT node for it
# (#ifdef CONFIG_STAGE_ZC50289HSHD02), so with this set the mipi-dsi driver has an actual
# competing node to probe alongside our own plain-RGB openke_panel node. Same bug class as
# BCMDHD/GT9XX/the camera ISP pipeline below - just missed in the first audit pass.
# CONFIG_STAGE_ZC50289HSHD02 is not set

# Core SoC infra audit (2026-07-19, FIRMWARE.md sec 12): confirmed MMC/I2C/DMA
# (CONFIG_MMC_SDHCI_INGENIC/CONFIG_I2C_INGENIC/CONFIG_INGENIC_PDMAC) were
# already enabled by this defconfig - only the TRNG was missing. The board DTS
# already has &dtrng { status = "okay"; } (matches the live device's confirmed
# soc_dtrng module) - this was a pure Kconfig gap, not a device-tree one.
# Switched to built-in 2026-07-21 for the same kmod-exhaustion reason above.
CONFIG_INGENIC_HW_RANDOM=y

# USB-Ethernet adapter (2026-07-19, FIRMWARE.md sec 16): this is a fresh build
# for the custom 6.6 kernel, NOT the Phase 1 module built against the stock
# 4.4.94 kernel (see ~/Documents/guppyscreen/scripts/build-ax88179-mipsel.sh) -
# the two are ABI-incompatible regardless, different kernel versions
# altogether. USB_NET_DRIVERS is a menuconfig gate the base defconfig leaves
# off (its own `default USB if USB` never applied, since the base defconfig
# already carries an explicit "is not set" for it) - same class of "menu
# gate not enabled by default" issue as CONFIG_INPUT_TOUCHSCREEN earlier.
CONFIG_USB_NET_DRIVERS=y
CONFIG_MII=y
CONFIG_USB_USBNET=m
CONFIG_USB_NET_AX88179_178A=m
#
# 2026-07-21, FIRMWARE.md sec 34: enabling USB_NET_DRIVERS pulls in a whole
# family of OTHER USB-net dongle drivers by default (AX8817X, CDC-ETHER,
# CDC-NCM, NET1080, CDC-SUBSET, ZAURUS, RTL8153-ECM, PHYLINK, plus the
# unrelated AX88796B PHY - a different chip family entirely, "X-Surf 100",
# not our AX88179/178A adapter at all) that we never actually asked for or
# need - only AX88179_178A is our real, physically-attached hardware. Real
# USB hotplug enumeration at boot could plausibly probe several of these
# overlapping candidates via request_module() before landing on the right
# one, adding to the same kmod-thread-exhaustion problem above. Explicitly
# disabled rather than left to default-select.
# CONFIG_USB_NET_AX8817X is not set
# CONFIG_USB_NET_CDCETHER is not set
# CONFIG_USB_NET_CDC_NCM is not set
# CONFIG_USB_NET_NET1080 is not set
# CONFIG_USB_NET_CDC_SUBSET_ENABLE is not set
# CONFIG_USB_NET_CDC_SUBSET is not set
# CONFIG_USB_NET_ZAURUS is not set
# CONFIG_USB_RTL8153_ECM is not set
# CONFIG_PHYLINK is not set
# CONFIG_AX88796B_PHY is not set

# Kernel image compression (2026-07-20, FIRMWARE.md sec 29): the real, first
# actual boot attempt with serial console connected showed U-Boot's SPL
# running fine through DDR init/RTOS/nvram read (identical to a real stock
# boot up to that exact point) and then simply never printing
# "Uncompressing Linux..." at all - the kernel never even started
# decompressing. Decoding the uImage headers directly confirmed why: the
# vendor base defconfig left this at its Linux-wide default of gzip
# (CONFIG_KERNEL_GZIP), but the real stock kernel/kernel2 partitions (both
# checked) are uncompressed (compression=0 in the uImage header) - this
# device's SPL is a minimal bootstrap stage and very plausibly has no gunzip
# support at all, matching the exact symptom of a silent hang right at that
# step. MIPS's own arch/mips/boot/Makefile only maps CONFIG_KERNEL_{GZIP,
# BZIP2,LZMA,LZO} to a compressed uImage suffix - XZ and ZSTD aren't checked
# by that logic at all, so selecting XZ here (a mandatory Kconfig choice,
# can't just be turned off) makes it fall through to the same uncompressed
# "uImage.bin" the stock kernel already uses, without needing to select the
# generic (x86-oriented, not MIPS-selectable) KERNEL_UNCOMPRESSED option.
#
# Getting this to actually stick took THREE fixes, not one - keeping this
# kept as a real fragment setting even though it's redundant (see below):
#   1. This CONFIG_KERNEL_XZ=y line (moot on its own - see 2 and 3).
#   2. arch/mips/Kconfig's `config MACH_XBURST2` block only ever
#      `select HAVE_KERNEL_GZIP` - never HAVE_KERNEL_XZ - so
#      CONFIG_KERNEL_XZ's own `depends on HAVE_KERNEL_XZ` could never be
#      satisfied and this line was silently dropped by every `oldconfig`
#      pass. Fixed with a `select HAVE_KERNEL_XZ` added right next to the
#      existing GZIP one (source-level kernel patch, see
#      patches/x2000_kernel_6.6-openke.patch).
#   3. Even with (2) fixed, Buildroot has its OWN separate top-level
#      compression choice (BR2_LINUX_KERNEL_GZIP/_XZ/... in linux/Config.in)
#      that force-overrides whatever the kernel's own .config/fragment says,
#      every single build, via LINUX_KCONFIG_FIXUP_CMDS's
#      `KCONFIG_ENABLE_OPT($(LINUX_COMPRESSION_OPT_y))` (linux/linux.mk:388)
#      - a completely independent mechanism from
#      BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES. Fixed by setting
#      BR2_LINUX_KERNEL_XZ=y (and un-setting _GZIP) in the top-level
#      artifacts/buildroot-halley5-v30-image/buildroot.config, which is what
#      actually determines the final compression choice.
#
# 2026-07-20, FIRMWARE.md sec 30: switched to LZO instead of the XZ-as-
# uncompressed trick above - the real uncompressed kernel is ~14.5MB, well
# over kernel2's fixed 8MB partition capacity (caught by flash-spare-slot.sh's
# own size check before ever attempting a write). LZO IS a real, special-
# cased compressed format in arch/mips/boot/Makefile's suffix-y logic, and
# its relative simplicity vs. gzip's DEFLATE makes it plausible this board's
# SPL supports it even though it apparently doesn't support gzip - genuinely
# untested until tried on real hardware. arch/mips/Kconfig's MACH_XBURST2
# needed the same "select HAVE_KERNEL_LZO" treatment as HAVE_KERNEL_XZ did,
# and BR2_LINUX_KERNEL_LZO=y (not _XZ) is what's now set in the top-level
# buildroot.config.
CONFIG_KERNEL_LZO=y

# 2026-07-21: the diag_init isolation test (see BRCMFMAC comment above)
# conclusively showed a trivial fully-static binary hits the identical
# "kmod busy with 50 threads" panic as busybox - not busybox-specific.
# Reverted init= back to the real /linuxrc (dropping the diag_init
# override; the DTB's own init=/linuxrc stands once this string no longer
# repeats init=). Keeping initcall_debug+loglevel=8 for extra visibility in
# case BRCMFMAC=y above doesn't fully resolve it - harmless either way.
#
# ieee754=relaxed (2026-07-21, FIRMWARE.md sec 36/37): THE fix for the boot
# panic that blocked this entire track for days ("Requested init /linuxrc
# failed (error -8)" / "kmod busy with 50 threads"). Root-caused via kernel
# printk instrumentation (since removed - see patches/ history if it's ever
# needed again) to arch/mips/kernel/elf.c's arch_check_elf(), which
# unconditionally rejects EVERY ELF exec via a MIPS NaN-encoding ABI check
# (mips_use_nan_legacy/mips_use_nan_2008, gated by this exact parameter,
# default "strict" = trust the live FPU probe of this XBurst2 core
# completely). Our toolchain builds legacy-NaN binaries
# (BR2_MIPS_NAN_LEGACY=y) but the kernel's probe wasn't accepting them on
# this exact SoC - confirmed via busybox, a from-scratch static diagnostic
# binary, and modprobe all being rejected identically, independent of
# content/linking, ruling out anything binary-specific. ieee754=relaxed
# unconditionally sets both mips_use_nan_legacy and mips_use_nan_2008 true,
# sidestepping the FPU-probe question entirely rather than needing to fix
# the probe itself (see arch/mips/kernel/fpu-probe.c). CONFIRMED WORKING on
# real hardware: first ever full boot on this track, all the way to a
# working `buildroot login:` shell, zero exec failures anywhere in the log.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="ieee754=relaxed"

# CONFIG_FILE_LOCKING (2026-07-23, FIRMWARE.md sec 23): real root cause of
# Moonraker's sqlite3.OperationalError: database is locked, hit on the very
# first-ever open of a brand new, single-process, uncontended database file
# (not a race - reproduced with a bare `flock()`/`fcntl(F_SETLK)` call on a
# fresh file too). The base x2000_halley5_v30_linux defconfig has this off
# (likely a kernel-size trim on the vendor's part, not a deliberate choice
# for this project). With it off, flock() returns ENOSYS and fcntl's lock
# commands fail outright (see fs/locks.c) - SQLite's default locking mode
# needs working POSIX advisory locks to open any file-backed database at
# all, so every component depending on sqlite3 (Moonraker's own database.py)
# was broken by this, regardless of tmpfs vs a real block device - this is
# a kernel-wide gap, not specific to any one filesystem.
CONFIG_FILE_LOCKING=y

# NebulaOS mutable-runtime mission, Memory Resilience Gate (2026-07-26):
# real root cause of a live OOM-killer event found on this exact 208MB-RAM
# device - `git clone` of an 11.5MB bundle needing only ~37-56MB total-vm
# was killed by the kernel OOM-killer (confirmed via dmesg:
# "Out of memory: Killed process NNNN (git)..."), and enabling swap on
# stock's own already-provisioned 128MB swap file (same shared partition)
# failed with "Function not implemented" - this kernel option was simply
# missing, confirmed via kernel.config inspection, not guessed. Has no
# real cost when unused; enabling it is what makes any swap backend
# (zram or a disk file) possible at all. NOTE: keep this comment block
# from repeating the literal option name below its own assignment line -
# doing so once produced a garbled "New value: ..." line in Buildroot's
# own fragment-merge log (the final built .config was still correct,
# confirmed via 06-verify.sh's check_builtin, but the log noise itself
# isn't worth risking twice).
CONFIG_SWAP=y

# zram (compressed RAM block device) is the primary memory-resilience
# layer - fast, no eMMC wear, absorbs short pressure spikes (factory
# seeding, git operations, Moonraker env installs) without ever touching
# flash. Chosen over zswap per this mission's own explicit direction
# (easier to inspect/recover/qualify on a BusyBox/Buildroot platform -
# zram exposes plain sysfs stats and a normal swap device, zswap does
# not). Built directly into the kernel (=y, not =m) rather than as a
# loadable module - this must be active before the very first
# memory-heavy boot step (S03's factory seeding, position 3 in the init
# sequence), well before this image's module-loading infrastructure would
# otherwise matter for anything else.
CONFIG_ZRAM=y

# LZ4 preferred as the default zram compressor per this mission's own
# guidance (lower latency than zstd/lzo-rle, and CRYPTO_LZ4 is pure C -
# no architecture-specific assembly requiring MIPS-specific verification,
# unlike some other compressor backends). CRYPTO_LZO was already enabled
# in this kernel (used elsewhere) and remains available as zram's own
# Kconfig-level fallback if LZ4 is ever found unsuitable after real
# workload measurement (docs/NEBULAOS_MEMORY_RESILIENCE.md sec 4).
CONFIG_CRYPTO_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# Live kernel-config inspection (`zcat /proc/config.gz`) - lets future
# qualification/debugging confirm the exact running kernel's config
# without needing the original build tree, requested explicitly for this
# sub-mission's own live-qualification steps.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# NebulaOS production optimization mission, Phase 9 (2026-07-30): remove
# kernel subsystems already proven unused by disabled device-tree nodes,
# absent physical hardware, absent userspace consumers, and/or runtime
# evidence gathered in the earlier production performance audit
# (docs/NEBULAOS_PRODUCTION_PERFORMANCE_ANALYSIS.md). Diagnostic/recovery
# symbols (IKCONFIG above, KALLSYMS, MAGIC_SYSRQ - already defaults, never
# touched here) and anything with a real consumer (Wi-Fi, display, touch,
# eMMC, serial, watchdog, thermal, swap/zram, required filesystems) are
# deliberately left untouched. Each candidate is disabled at its top-level
# menu gate only, relying on Kconfig's own dependency resolution to
# cascade-clear children - `make linux-oldconfig` must be re-run and its
# resulting .config inspected before trusting any cascade actually cleared
# everything expected (the HALLEY5_CAMERA_BOARD gate above already proved
# once that a cascade can leave a sibling symbol behind - see FIRMWARE.md).

# ALSA/ASoC (sound): every DT audio endpoint disabled, confirmed live via
# empty /proc/asound/cards. No speaker/mic/audio-jack hardware exists on
# this printer at all. Disabling just the CONFIG_SND/CONFIG_SOUND top-level
# gates was NOT enough - confirmed via two successive real
# `make linux-configure` dry runs, the vendor base defconfig `default y`s
# this whole tree from several different points at once
# (SND_ASOC_INGENIC_HALLEY5_V20 the board driver, then SND_ASOC_INGENIC/
# SND_ASOC_INGENIC_ICDC_INNO underneath even after that one was cleared),
# each re-selecting CONFIG_SND back on regardless of the top-level gate.
# Disabling every currently-enabled symbol in this tree directly, rather
# than trusting a cascade from the top, since a cascade already proved
# incomplete twice in a row here.
# CONFIG_SND_ASOC_INGENIC_HALLEY5_V20 is not set
# CONFIG_SND_ASOC_INGENIC_ICDC_INNO is not set
# CONFIG_SND_ASOC_INGENIC_AS_VIR_FE is not set
# CONFIG_SND_ASOC_INGENIC_AS_DMIC is not set
# CONFIG_SND_ASOC_INGENIC_AS_SPDIF is not set
# CONFIG_SND_ASOC_INGENIC_AS_BAIC is not set
# CONFIG_SND_ASOC_INGENIC_AS_FE is not set
# CONFIG_SND_ASOC_INGENIC_AS_V2 is not set
# CONFIG_SND_ASOC_INGENIC is not set
# CONFIG_SND_SOC_I2C_AND_SPI is not set
# CONFIG_SND_SOC is not set
# CONFIG_SND_DRIVERS is not set
# CONFIG_SND_CTL_FAST_LOOKUP is not set
# CONFIG_SND_VERBOSE_PROCFS is not set
# CONFIG_SND_PROC_FS is not set
# CONFIG_SND_SUPPORT_OLD_API is not set
# CONFIG_SND_DYNAMIC_MINORS is not set
# CONFIG_SND_PCM_TIMER is not set
# CONFIG_SND_JACK_INPUT_DEV is not set
# CONFIG_SND_JACK is not set
# CONFIG_SND_PCM is not set
# CONFIG_SND_TIMER is not set
# CONFIG_SND is not set
# CONFIG_SOUND is not set

# Ingenic internal ISP/rotate/video-codec M2M pipeline: this project's own
# real camera is a generic external USB UVC webcam (ustreamer), whose own
# onboard ISP does JPEG compression - entirely separate hardware from this
# SoC's internal pipeline. CONFIG_HALLEY5_CAMERA_BOARD/
# CONFIG_INGENIC_ISP_CAMERA_OV2735A (the sensor driver for the vendor
# reference board's own camera daughterboard, which this product doesn't
# have) are already disabled above - these three are the remaining
# underlying M2M blocks, confirmed by this project's own earlier real boot
# log evidence (see the BRCMFMAC/HALLEY5_CAMERA_BOARD comment above) to
# probe and claim /dev/video0-2 unconditionally at boot regardless of any
# USB webcam being present, contributing real (if modest) boot-time kmod/
# probe pressure for hardware nothing in this image ever uses.
# CONFIG_VIDEO_INGENIC_ISP is not set
# CONFIG_VIDEO_INGENIC_ROTATE is not set
# CONFIG_VIDEO_INGENIC_VCODEC is not set

# Bluetooth HCI UART transport: uart3 (the only UART wired to the BT
# chip) is permanently disabled in this board's own DTS due to a real pin
# conflict with the NS2009 touch controller's i2c4 bus (see the
# BT_HCIUART_BCM_H5 comment above, "UNTESTED against real hardware" - it
# can never actually be tested, since the transport it needs has no live
# path to the chip regardless of kernel support). No Bluetooth hardware
# can ever attach on this product as currently wired.
# CONFIG_BT is not set

# netfilter/iptables/bridge/STP/LLC: no userspace tool ships anywhere in
# this image to configure any of it (no iptables/nft/brctl/ebtables
# binary in the Buildroot package set) - this printer has one static
# Wi-Fi client interface, no routing/bridging/firewall role of any kind.
# CONFIG_NETFILTER is not set
# CONFIG_BRIDGE is not set
# CONFIG_STP is not set
# CONFIG_LLC is not set

# SFC (SPI NAND/NOR flash controller): this board boots from eMMC
# (mmcblk0), confirmed live via an empty /proc/mtd - no SPI-NOR/NAND flash
# chip exists on this product for the SFC controller to ever attach to.
# CONFIG_MTD is not set
# CONFIG_INGENIC_SFC is not set

# SADC/ADC MFD cells: CONFIG_IIO (the framework any ADC channel would need
# to expose a device node through) is not compiled in this kernel at all
# (confirmed above, already the case before this change) - these cells are
# structurally incapable of exposing anything to userspace regardless.
# CONFIG_MFD_INGENIC_SADC_AUX is not set
# CONFIG_MFD_INGENIC_SADC_V13 is not set

# Production-only debug overhead: real, measurable per-lock-acquisition
# cost with no diagnostic value once this build is genuinely production-
# qualified (unlike IKCONFIG/KALLSYMS/MAGIC_SYSRQ above, kept deliberately
# for field debugging - these two are pure development aids).
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_FW_LOADER_DEBUG is not set

# NOT disabled despite being a real audit finding: the on-chip Ethernet
# MAC candidate from the original audit. CONFIG_ETHERNET is already not
# set in this kernel's actual .config (verified directly against a fresh
# /proc/config.gz pull, 2026-07-30) - whatever the audit observed no
# longer applies to the current build, so there is nothing left here to
# disable; noted rather than silently dropped from the candidate list.
#--- NEBULAOS_PREEMPT_RT_VARIANT_BEGIN ---
# Pre-qualification mission Phase A8 (2026-07-31) - PREEMPT_RT
# qualification variant. HZ is deliberately left unchanged.
CONFIG_PREEMPT_RT=y
#--- NEBULAOS_PREEMPT_RT_VARIANT_END ---
#--- NEBULAOS_PAN_VSYNC_GATE_VARIANT_BEGIN ---
# Display investigation mission (2026-08-01) - DISPLAY-V1
# vsync-gated pan_display qualification variant.
CONFIG_FB_INGENIC_PAN_VSYNC_GATE=y
#--- NEBULAOS_PAN_VSYNC_GATE_VARIANT_END ---
#--- NEBULAOS_BACKLIGHT_FINAL_CONTROLLER_VARIANT_BEGIN ---
# Post-incident backlight controller redesign (2026-08-02+) -
# DISPLAY-B-FINAL kernel-owned backlight final controller variant.
CONFIG_NEBULAOS_BACKLIGHT_FINAL_CONTROLLER=y
#--- NEBULAOS_BACKLIGHT_FINAL_CONTROLLER_VARIANT_END ---
#--- NEBULAOS_PWM_STATE_READBACK_VARIANT_BEGIN ---
# NebulaOS PWM state readback mission (2026-08-xx) -
# pwm-ingenic-v2.c .get_state variant. Offline/compile-tested only -
# do not enable for a production/active-slot build until live
# hardware qualification confirms the readback.
CONFIG_PWM_INGENIC_V2_GET_STATE=y
#--- NEBULAOS_PWM_STATE_READBACK_VARIANT_END ---
#--- NEBULAOS_TOUCH_FINAL_QUALIFICATION_VARIANT_BEGIN ---
# Display/touch investigation mission follow-on (2026-08-02+) -
# TOUCH-FINAL-QUALIFICATION genuinely-one-shot irq-assist variant.
CONFIG_TOUCHSCREEN_NS2009_FINAL_QUALIFICATION=y
#--- NEBULAOS_TOUCH_FINAL_QUALIFICATION_VARIANT_END ---
