# NebulaOS BR2_EXTERNAL package menu.
#
# Everything NebulaOS adds to Buildroot lives here. Official Buildroot stays
# PRISTINE: no file under vendor/buildroot-x2000/ is edited, replaced or
# patched by this project. That is an enforced property, not a convention -
# 06-verify.sh's check_vendor_pin() allowlist is the acceptance test, and it
# permits exactly one expected working-tree modification (local.mk, which
# carries LINUX_OVERRIDE_SRCDIR and cannot live out-of-tree).
#
# Packages here exist for ONE reason only: the dependency is genuinely not
# packaged by Buildroot 2025.02.18. Anything upstream already ships is used
# from upstream, at upstream's version. See
# docs/BUILDROOT_2025_MIGRATION_PARITY.md for the full mapping.

menu "NebulaOS packages"

source "$BR2_EXTERNAL_NEBULAOS_PATH/package/python-apprise/Config.in"
source "$BR2_EXTERNAL_NEBULAOS_PATH/package/python-importlib-metadata/Config.in"
source "$BR2_EXTERNAL_NEBULAOS_PATH/package/python-inotify-simple/Config.in"
source "$BR2_EXTERNAL_NEBULAOS_PATH/package/python-ldap3/Config.in"
source "$BR2_EXTERNAL_NEBULAOS_PATH/package/python-libnacl/Config.in"
source "$BR2_EXTERNAL_NEBULAOS_PATH/package/python-preprocess-cancellation/Config.in"
source "$BR2_EXTERNAL_NEBULAOS_PATH/package/python-streaming-form-data/Config.in"
source "$BR2_EXTERNAL_NEBULAOS_PATH/package/python-wheel-target/Config.in"
source "$BR2_EXTERNAL_NEBULAOS_PATH/package/python-zipp/Config.in"

endmenu
