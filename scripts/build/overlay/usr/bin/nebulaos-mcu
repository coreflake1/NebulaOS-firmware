#!/bin/sh
#
# nebulaos-mcu - MCU management CLI for NebulaOS
#
# Subcommands:
#   status    Show current MCU lifecycle state (from last boot check)
#   flash     Manually trigger MCU firmware restore (known-stock only)
#   managed   Show or set whether auto-restore runs at boot
#
# The MCU lifecycle state machine (mcu_lifecycle.py) distinguishes:
#   SUPPORTED_HW_NATIVE_APP       - candidate-001 running, healthy
#   SUPPORTED_HW_KNOWN_STOCK_APP  - stock Creality detected, restore eligible
#   SUPPORTED_HW_UNKNOWN_APP      - unrecognized app, never auto-restore
#   UNSUPPORTED_HW                - wrong hardware, block everything
#   MCU_UNREACHABLE               - serial unreachable, warn only
#
# "Manual ownership persists in /usr/data" (DECISIONS.md):
#   /usr/data/nebulaos/mcu/managed contains "true" or "false". When false,
#   S50nebulaos-mcu-guard still identifies the MCU but skips auto-restore.
#   `nebulaos-mcu flash` ignores this flag (explicit manual action).

set -eu

MCU_GUARD_STATE="${MCU_GUARD_STATE:-/run/nebulaos-mcu-guard.state}"
MCU_MANAGED_DIR="${MCU_MANAGED_DIR:-/usr/data/nebulaos/mcu}"
MCU_MANAGED_FLAG="${MCU_MANAGED_FLAG:-${MCU_MANAGED_DIR}/managed}"
MCU_IDENTITY_CHECK="${MCU_IDENTITY_CHECK:-/etc/nebulaos/mcu_identity_check.py}"
PYTHON3="${MCU_GUARD_PYTHON3:-/usr/bin/python3}"

die() { echo "nebulaos-mcu: error: $1" >&2; exit 1; }

# ---------- status ----------

cmd_status() {
    if [ ! -f "$MCU_GUARD_STATE" ]; then
        echo "No boot-time MCU check has run yet."
        echo "The guard runs automatically at boot (S50nebulaos-mcu-guard)."
        echo "Reboot or run: /etc/init.d/S50nebulaos-mcu-guard start"
        exit 0
    fi

    # Source the state file (key=value pairs)
    . "$MCU_GUARD_STATE"

    echo "MCU Lifecycle Status"
    echo "===================="
    echo "Guard result:          ${MCU_GUARD_RESULT:-unknown}"
    echo "Lifecycle state:       ${MCU_LIFECYCLE_STATE:-unknown}"
    echo "Application identity:  ${MCU_APPLICATION_IDENTITY:-unknown}"
    echo "Application class:     ${MCU_APPLICATION_CLASS:-unknown}"
    echo "Hardware ID status:    ${MCU_HW_ID_STATUS:-not_checked}"
    echo "Hardware identity:     ${MCU_IDENTITY:-unknown}"
    echo "Restore result:        ${MCU_RESTORE_RESULT:-not_attempted}"
    echo "Timestamp:             ${MCU_GUARD_TIMESTAMP:-unknown}"
    echo ""

    _managed=$(read_managed_flag)
    echo "Auto-restore at boot:  ${_managed}"
}

# ---------- flash ----------

cmd_flash() {
    if [ ! -f "$MCU_IDENTITY_CHECK" ]; then
        die "identity check helper not found at $MCU_IDENTITY_CHECK"
    fi
    if [ ! -x "$PYTHON3" ]; then
        die "Python interpreter not found at $PYTHON3"
    fi

    echo "Running MCU lifecycle check..."
    check_output=$("$PYTHON3" "$MCU_IDENTITY_CHECK" 2>&1) || true

    _lifecycle_state=$(echo "$check_output" | sed -n 's/^MCU_LIFECYCLE_STATE=//p' | head -1)
    _application_class=$(echo "$check_output" | sed -n 's/^MCU_APPLICATION_CLASS=//p' | head -1)
    _guard_result=$(echo "$check_output" | sed -n 's/^MCU_GUARD_RESULT=//p' | tail -1)
    _restore_result=$(echo "$check_output" | sed -n 's/^MCU_RESTORE_RESULT=//p' | head -1)

    case "$_application_class" in
        NATIVE_CANDIDATE_001)
            echo "MCU is already running native firmware (candidate-001)."
            echo "No restore needed."
            exit 0
            ;;
        KNOWN_STOCK)
            echo "Stock Creality firmware detected."
            if [ "$_restore_result" = "RESTORED_AND_VERIFIED" ]; then
                echo "Restore completed and verified successfully."
                exit 0
            elif [ -n "$_restore_result" ] && [ "$_restore_result" != "not_attempted" ]; then
                echo "Restore attempted but failed: $_restore_result"
                echo ""
                echo "Full output:"
                echo "$check_output"
                exit 1
            else
                echo "Restore was authorized but did not run."
                echo "Full output:"
                echo "$check_output"
                exit 1
            fi
            ;;
        UNKNOWN_APPLICATION|"")
            echo "REFUSED: Unrecognized MCU application firmware."
            echo "Application class: ${_application_class:-unknown}"
            echo "Lifecycle state:   ${_lifecycle_state:-unknown}"
            echo ""
            echo "Auto-restore only works for KNOWN stock Creality firmware."
            echo "An unrecognized application will never be auto-flashed."
            echo ""
            echo "Full output:"
            echo "$check_output"
            exit 1
            ;;
        *)
            echo "Unexpected application class: $_application_class"
            echo "$check_output"
            exit 1
            ;;
    esac
}

# ---------- managed ----------

read_managed_flag() {
    if [ -f "$MCU_MANAGED_FLAG" ]; then
        cat "$MCU_MANAGED_FLAG"
    else
        echo "true"
    fi
}

cmd_managed() {
    if [ $# -eq 0 ]; then
        _managed=$(read_managed_flag)
        echo "Auto-restore at boot: ${_managed}"
        if [ "$_managed" = "true" ]; then
            echo "S50nebulaos-mcu-guard will auto-restore native firmware"
            echo "if stock Creality firmware is detected at boot."
        else
            echo "S50nebulaos-mcu-guard will identify the MCU but will NOT"
            echo "auto-restore. Use 'nebulaos-mcu flash' to restore manually."
        fi
        return
    fi

    case "$1" in
        on|true)
            mkdir -p "$MCU_MANAGED_DIR"
            echo "true" > "$MCU_MANAGED_FLAG"
            echo "Auto-restore enabled. Native firmware will be restored at boot"
            echo "if stock Creality firmware is detected."
            ;;
        off|false)
            mkdir -p "$MCU_MANAGED_DIR"
            echo "false" > "$MCU_MANAGED_FLAG"
            echo "Auto-restore disabled. S50nebulaos-mcu-guard will still"
            echo "identify the MCU but will not flash. Use 'nebulaos-mcu flash'"
            echo "to restore manually."
            ;;
        *)
            die "managed: expected 'on' or 'off', got '$1'"
            ;;
    esac
}

# ---------- main ----------

usage() {
    echo "Usage: nebulaos-mcu <command> [args]"
    echo ""
    echo "Commands:"
    echo "  status          Show current MCU lifecycle state"
    echo "  flash           Manually trigger MCU firmware restore"
    echo "  managed [on|off] Show or set auto-restore at boot"
    exit 1
}

if [ $# -eq 0 ]; then
    usage
fi

command="$1"
shift

case "$command" in
    status)  cmd_status ;;
    flash)   cmd_flash ;;
    managed) cmd_managed "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command '$command'. Run 'nebulaos-mcu help' for usage." ;;
esac
