#!/bin/sh
#
# nebulaos-mcu - MCU management CLI for NebulaOS
#
# Subcommands:
#   status    Show current MCU lifecycle state (read-only, from last boot check)
#   flash <f> Flash arbitrary firmware file to MCU (sets manual ownership)
#   managed   Immediately restore pinned native firmware (re-enter managed mode)
#
# The MCU lifecycle state machine (mcu_lifecycle.py) distinguishes:
#   SUPPORTED_HW_NATIVE_APP       - candidate-001 running, healthy
#   SUPPORTED_HW_KNOWN_STOCK_APP  - stock Creality detected, restore eligible
#   SUPPORTED_HW_UNKNOWN_APP      - unrecognized app, never auto-restore
#   UNSUPPORTED_HW                - wrong hardware, block everything
#   MCU_UNREACHABLE               - serial unreachable, warn only
#
# Ownership model:
#   /usr/data/nebulaos/mcu/managed contains "true" or "false".
#   - managed=true (default): NebulaOS manages the MCU. Boot guard restores
#     native if stock is detected.
#   - managed=false: User flashed custom firmware via `flash <file>`.
#     Boot guard skips restore for unknown applications but still restores
#     from known stock (stock recovery is always the right call).
#
# `nebulaos-mcu flash <file>` sets managed=false (manual ownership).
# `nebulaos-mcu managed` immediately restores native and sets managed=true.

set -eu

MCU_GUARD_STATE="${MCU_GUARD_STATE:-/run/nebulaos-mcu-guard.state}"
MCU_MANAGED_DIR="${MCU_MANAGED_DIR:-/usr/data/nebulaos/mcu}"
MCU_MANAGED_FLAG="${MCU_MANAGED_FLAG:-${MCU_MANAGED_DIR}/managed}"
MCU_IDENTITY_CHECK="${MCU_IDENTITY_CHECK:-/etc/nebulaos/mcu_identity_check.py}"
MCU_FLASH_FILE="${MCU_FLASH_FILE:-/etc/nebulaos/mcu_flash_file.py}"
MOONRAKER_URL="${MOONRAKER_URL:-http://127.0.0.1:7125}"
PYTHON3="${MCU_GUARD_PYTHON3:-/usr/bin/python3}"

die() { echo "nebulaos-mcu: error: $1" >&2; exit 1; }

# ---------- helpers ----------

read_managed_flag() {
    if [ -f "$MCU_MANAGED_FLAG" ]; then
        cat "$MCU_MANAGED_FLAG"
    else
        echo "true"
    fi
}

set_managed() {
    mkdir -p "$MCU_MANAGED_DIR"
    echo "$1" > "$MCU_MANAGED_FLAG"
}

check_printer_idle() {
    _state=$("$PYTHON3" -c "
import json, sys
try:
    import urllib.request
    resp = urllib.request.urlopen('${MOONRAKER_URL}/printer/objects/query?print_stats', timeout=5)
    data = json.loads(resp.read().decode('utf-8'))
    print(data['result']['status']['print_stats']['state'])
except Exception:
    print('unknown')
" 2>/dev/null) || _state="unknown"

    case "$_state" in
        printing)
            echo "REFUSED: Printer is printing. Cannot flash MCU during a print." >&2
            return 1
            ;;
        paused)
            echo "REFUSED: Printer is paused. Cannot flash MCU while paused." >&2
            return 1
            ;;
    esac
    return 0
}

# ---------- status ----------

cmd_status() {
    if [ ! -f "$MCU_GUARD_STATE" ]; then
        echo "No boot-time MCU check has run yet."
        echo "The guard runs automatically at boot (S50nebulaos-mcu-guard)."
        echo "Reboot or run: /etc/init.d/S50nebulaos-mcu-guard start"
        exit 0
    fi

    # Source the state file (key=value pairs)
    . "$MCU_GUARD_STATE"

    echo "MCU Lifecycle Status"
    echo "===================="
    echo "Guard result:          ${MCU_GUARD_RESULT:-unknown}"
    echo "Lifecycle state:       ${MCU_LIFECYCLE_STATE:-unknown}"
    echo "Application identity:  ${MCU_APPLICATION_IDENTITY:-unknown}"
    echo "Application class:     ${MCU_APPLICATION_CLASS:-unknown}"
    echo "Hardware ID status:    ${MCU_HW_ID_STATUS:-not_checked}"
    echo "Hardware identity:     ${MCU_IDENTITY:-unknown}"
    echo "Restore result:        ${MCU_RESTORE_RESULT:-not_attempted}"
    echo "Timestamp:             ${MCU_GUARD_TIMESTAMP:-unknown}"
    echo ""

    _managed=$(read_managed_flag)
    echo "Auto-restore at boot:  ${_managed}"
}

# ---------- flash <file> ----------

cmd_flash() {
    if [ $# -eq 0 ]; then
        die "flash requires a firmware file. Usage: nebulaos-mcu flash <file>"
    fi
    FIRMWARE_FILE="$1"

    if [ ! -f "$FIRMWARE_FILE" ]; then
        die "firmware file not found: $FIRMWARE_FILE"
    fi
    if [ ! -r "$FIRMWARE_FILE" ]; then
        die "firmware file not readable: $FIRMWARE_FILE"
    fi

    check_printer_idle || exit 1

    if [ ! -f "$MCU_FLASH_FILE" ]; then
        die "flash helper not found at $MCU_FLASH_FILE"
    fi
    if [ ! -x "$PYTHON3" ]; then
        die "Python interpreter not found at $PYTHON3"
    fi

    echo "Flashing $FIRMWARE_FILE to MCU..."
    if "$PYTHON3" "$MCU_FLASH_FILE" "$FIRMWARE_FILE"; then
        set_managed "false"
        echo ""
        echo "MCU firmware flashed successfully."
        echo "Auto-restore disabled (manual ownership)."
        echo "Use 'nebulaos-mcu managed' to restore NebulaOS native firmware."
    else
        echo ""
        echo "Flash failed. MCU ownership unchanged." >&2
        exit 1
    fi
}

# ---------- managed ----------

cmd_managed() {
    if [ ! -f "$MCU_IDENTITY_CHECK" ]; then
        die "identity check helper not found at $MCU_IDENTITY_CHECK"
    fi
    if [ ! -x "$PYTHON3" ]; then
        die "Python interpreter not found at $PYTHON3"
    fi

    echo "Checking MCU state and restoring native firmware..."
    check_output=$("$PYTHON3" "$MCU_IDENTITY_CHECK" 2>&1) || true

    _application_class=$(echo "$check_output" | sed -n 's/^MCU_APPLICATION_CLASS=//p' | head -1)
    _restore_result=$(echo "$check_output" | sed -n 's/^MCU_RESTORE_RESULT=//p' | head -1)
    _guard_result=$(echo "$check_output" | sed -n 's/^MCU_GUARD_RESULT=//p' | tail -1)

    case "$_application_class" in
        NATIVE_CANDIDATE_001)
            set_managed "true"
            echo "MCU is already running native firmware (candidate-001)."
            echo "Auto-restore enabled."
            exit 0
            ;;
        KNOWN_STOCK)
            if [ "$_restore_result" = "RESTORED_AND_VERIFIED" ]; then
                set_managed "true"
                echo "Native firmware restored and verified."
                echo "Auto-restore enabled."
                exit 0
            else
                echo "FAILED: Could not restore native firmware." >&2
                echo "Restore result: ${_restore_result:-unknown}" >&2
                echo "" >&2
                echo "Full output:" >&2
                echo "$check_output" >&2
                exit 1
            fi
            ;;
        UNKNOWN_APPLICATION|"")
            echo "REFUSED: Unrecognized MCU application firmware." >&2
            echo "Cannot auto-restore from unknown firmware." >&2
            echo "Use 'nebulaos-mcu flash <file>' to flash specific firmware," >&2
            echo "or flash stock Creality firmware first, then retry." >&2
            exit 1
            ;;
        *)
            echo "Unexpected application class: $_application_class" >&2
            echo "$check_output" >&2
            exit 1
            ;;
    esac
}

# ---------- main ----------

usage() {
    echo "Usage: nebulaos-mcu <command> [args]"
    echo ""
    echo "Commands:"
    echo "  status          Show current MCU lifecycle state (read-only)"
    echo "  flash <file>    Flash arbitrary firmware file to MCU"
    echo "  managed         Restore native firmware and re-enter managed mode"
    exit 1
}

if [ $# -eq 0 ]; then
    usage
fi

command="$1"
shift

case "$command" in
    status)  cmd_status ;;
    flash)   cmd_flash "$@" ;;
    managed) cmd_managed ;;
    -h|--help|help) usage ;;
    *) die "unknown command '$command'. Run 'nebulaos-mcu help' for usage." ;;
esac
