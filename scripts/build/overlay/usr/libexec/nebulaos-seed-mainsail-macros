#!/usr/bin/env python3
#
# NebulaOS Phase 2 macro-cleanup/Mainsail-grouping mission (2026-09-04,
# extended 2026-09-06 - RC2 overnight closure).
#
# Seeds NebulaOS's own default Mainsail macro groups (Moonraker database
# namespace "mainsail", key "macros.macrogroups.<id>") the first time
# Moonraker is confirmed reachable, migrates any pre-existing groups from
# their old underscore-style IDs to the current hyphenated ones, and
# defaults a genuinely untouched install's macros.mode to "expert" - same
# never-block-boot, never-trust-HTTP-2xx-alone, verify-after-write,
# atomic-marker conventions as nebulaos-seed-camera (see that script's own
# header for the fuller rationale; this one is deliberately structured
# identically).
#
# Why database keys, not Mainsail's own ".../default.json" fresh-install
# mechanism: that mechanism is real (Mainsail's own `gui/initDb` fetches
# GET /server/files/config/<X>/default.json on a genuinely fresh
# install), but (a) it only ever runs once, on an install where the
# `mainsail` namespace does not exist AT ALL yet - it cannot add a new
# NebulaOS group to an ALREADY-INITIALIZED existing install, which is
# exactly the safe-migration case this mission also requires, and
# (b) the exact config-subdirectory path segment Mainsail's own minified
# bundle uses for <X> could not be confirmed with confidence from static
# analysis of the vendored dist (see the Phase 2 overnight research
# report). Posting directly to Moonraker's own, already-documented
# `/server/database/item` API - the same mechanism Mainsail's own code
# uses internally for every group edit a user makes by hand - works
# identically for a genuinely fresh install and an existing one, with no
# unconfirmed path dependency, and is exactly the same pattern this
# project already uses for the default webcam (nebulaos-seed-camera).
#
# 2026-09-06 RC2 finding (read straight from the pinned Mainsail v2.18.2
# vendored dist, vendor/mainsail-dist/dist/assets/index-*.js - not
# guessed): dashboard-layout seeding is NOT needed and was never missing.
# Mainsail's own `gui/getPanels` getter auto-synthesizes a
# `{name: "macrogroup_<id>", visible: true}` entry for every id returned
# by `macros/getAllMacrogroups` whenever `macros.mode === "expert"` - the
# very first render after a group exists and mode is expert is enough for
# the panel to appear on every viewport's first layout slot. The 2026-09-04
# caution about "the exact object shape ... could not be confirmed" was
# reasonable at the time but is superseded by this direct source read: no
# separate dashboard.desktopLayout1/mobileLayout write is required, or
# implemented here.
#
# 2026-09-06 RC2 finding, the real (narrower) blast radius of the
# underscore-ID bug: `getPanelName()` in that same bundle resolves a
# panel's display title via `panelName.split("_")[1]` - for
# "macrogroup_nebulaos_calibration" that yields "nebulaos" (not
# "nebulaos_calibration"), which fails `macrogroups.find(g => g.id ===
# "nebulaos")` and falls back to a generic "Macrogroup" label in the
# Settings > Dashboard "hide panels" list and the icon lookup. The panel's
# own card header text still reads correctly (it renders `group.name`
# directly, e.g. "Calibration"), and the panel-visibility filter uses a
# different, correct `name.slice(11)` extraction - so underscore IDs do
# not actually stop the six group panels from appearing or working; they
# only mislabel one secondary settings-list entry per group. Renaming to
# hyphenated IDs, as the mission requires regardless, removes this defect
# entirely (an id with no further "_" makes `split("_")[1]` recover the
# same string `slice(11)` does).
#
# Scope deliberately does NOT include dashboard-layout seeding for the
# reason given above (it is unnecessary, not merely deferred).
#
# Testable in full offline: see tests/nebulaos-seed-mainsail-macros-tests.py.

from __future__ import annotations

import json
import os
import sys
import time
import urllib.error
import urllib.request

MOONRAKER_BASE = os.environ.get("NEBULAOS_MOONRAKER_BASE", "http://127.0.0.1:7125")
NEBULAOS_ROOT = os.environ.get("NEBULAOS_ROOT", "/usr/data/nebulaos")
MARKER_PATH = os.environ.get(
    "NEBULAOS_MAINSAIL_MACRO_MARKER",
    os.path.join(NEBULAOS_ROOT, "system", "default-mainsail-macros-seeded.json"),
)

RETRY_ATTEMPTS = int(os.environ.get("NEBULAOS_MAINSAIL_SEED_RETRIES", "30"))
RETRY_DELAY_S = float(os.environ.get("NEBULAOS_MAINSAIL_SEED_RETRY_DELAY", "2"))

# NebulaOS-owned macro groups (Phase 2 upstream-first config refactor,
# 2026-09-05; renamed to hyphenated stable IDs, RC2 overnight closure,
# 2026-09-06 - Mainsail's own Dashboard.vue lineage parses a panel name
# as `"macrogroup_" + name.split("_")[1]`, so any further underscore in
# the id itself is unsafe; hyphens are not split on). Stable IDs (the DB
# key suffix) are owned by NebulaOS and must never change again once
# shipped in this hyphenated form - a later firmware version adding/
# editing a group's own CONTENTS re-seeds nothing for a group that
# already exists (never overwrite a user-modified group), but a brand
# new stable ID from a later version will still seed correctly into an
# existing install on next boot, which is exactly the "add only when
# missing" behavior.
#
# Every group carries explicit metadata (mission requirement): name,
# color, and the three state-visibility flags, in addition to its macro
# list - `color` is a Mainsail group accent, not a per-macro state gate;
# per-macro `showInStandby`/`showInPrinting`/`showInPause` (see _macro())
# are the real state restrictions and are deliberately NOT all opened up
# just because the containing panel is visible while printing (calibration/
# PID macros stay hidden mid-print even though the Calibration panel itself
# is visible in every state).
#
# Macro `name` values below are real [gcode_macro] names. NEBULAOS_*
# macros are public wrappers calling private _NEBULAOS_* Python backends
# (see calibration.cfg). Upstream UI adapters (AXIS_TWIST_X/Y, PID_BED/
# PID_HOTEND) expose upstream commands as one-click Mainsail buttons.
def _macro(pos, name, show_in_standby=True, show_in_printing=False, show_in_pause=False):
    return {
        "pos": pos,
        "name": name,
        "color": "",
        "showInStandby": show_in_standby,
        "showInPrinting": show_in_printing,
        "showInPause": show_in_pause,
    }


def _group(name, macros):
    return {
        "name": name,
        "color": "primary",
        "showInStandby": True,
        "showInPause": True,
        "showInPrinting": True,
        "macros": macros,
    }


DEFAULT_GROUPS = {
    "nebulaos-calibration": _group("Calibration", [
        _macro(0, "NEBULAOS_AUTO_CALIBRATE"),
        _macro(1, "NEBULAOS_Z_OFFSET_CALIBRATE"),
        _macro(2, "AXIS_TWIST_X"),
        _macro(3, "AXIS_TWIST_Y"),
        _macro(4, "PID_BED"),
        _macro(5, "PID_HOTEND"),
        _macro(6, "NEBULAOS_NOZZLE_CLEAN"),
    ]),
    "nebulaos-input-shaper": _group("Input Shaper", [
        _macro(0, "NEBULAOS_INPUT_SHAPER_CALIBRATE"),
        _macro(1, "NEBULAOS_CALIBRATION_CONTINUE"),
        _macro(2, "NEBULAOS_CALIBRATION_CANCEL"),
    ]),
    "nebulaos-extruder": _group("Extruder", [
        _macro(0, "NEBULAOS_ESTEPS_CALIBRATE"),
        _macro(1, "LOAD_FILAMENT"),
        _macro(2, "UNLOAD_FILAMENT"),
        _macro(3, "M600", show_in_printing=True),
        _macro(4, "PURGE_MORE", show_in_pause=True),
        _macro(5, "RESUME_FILAMENT_CHANGE", show_in_pause=True),
        _macro(6, "CANCEL_FILAMENT_CHANGE", show_in_pause=True),
    ]),
    "nebulaos-camera": _group("Camera", [
        _macro(0, "SET_CAMERA_QUALITY_LOW"),
        _macro(1, "SET_CAMERA_QUALITY_MED"),
        _macro(2, "SET_CAMERA_QUALITY_HIGH"),
    ]),
    "nebulaos-maintenance": _group("Maintenance", [
        _macro(0, "BEEP"),
        _macro(1, "PLAY_TUNE"),
    ]),
    "nebulaos-recovery": _group("Recovery", [
        _macro(0, "NEBULAOS_RESUME_POWER_LOSS"),
        _macro(1, "NEBULAOS_CLEAR_POWER_LOSS_RECOVERY"),
    ]),
}

# Legacy (pre-2026-09-06) underscore-style IDs this script itself shipped
# from 2026-09-04 through RC1 (2026-09-05), keyed to their hyphenated
# replacement. Fixed and historical - never add a "new" legacy mapping
# here; only ever these six ever shipped under the old scheme.
LEGACY_GROUP_ID_MAP = {
    "nebulaos_calibration": "nebulaos-calibration",
    "nebulaos_input_shaper": "nebulaos-input-shaper",
    "nebulaos_extruder": "nebulaos-extruder",
    "nebulaos_camera": "nebulaos-camera",
    "nebulaos_maintenance": "nebulaos-maintenance",
    "nebulaos_recovery": "nebulaos-recovery",
}

MODE_KEY = "macros.mode"
DEFAULT_MODE = "expert"


class TransportError(Exception):
    """Raised for any failure to reach Moonraker or parse its response -
    callers must always treat this as "unknown," never "safe to
    proceed." Deliberately does NOT distinguish "key not found" as a
    TransportError - see get_item(), which treats a 404 as a normal,
    expected "not seeded yet" result."""


def real_http_get(path: str) -> str:
    with urllib.request.urlopen(MOONRAKER_BASE + path, timeout=5) as resp:
        return resp.read().decode("utf-8")


def real_http_get_status(path: str):
    """Like real_http_get, but returns (status_or_None, body) instead of
    raising on a 404 - callers need to tell "key genuinely absent" apart
    from "transport failure," which a bare exception can't do cleanly
    across the fake/real boundary this module tests against."""
    try:
        with urllib.request.urlopen(MOONRAKER_BASE + path, timeout=5) as resp:
            return resp.status, resp.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            return 404, None
        raise


def real_http_post_json(path: str, payload: dict) -> str:
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        MOONRAKER_BASE + path,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=8) as resp:
        return resp.read().decode("utf-8")


def real_http_delete_status(path: str):
    """Same (status_or_None, body) contract as real_http_get_status,
    for DELETE /server/database/item - a 404 (key already gone) is a
    normal, expected outcome for an idempotent second run, never an
    error."""
    req = urllib.request.Request(MOONRAKER_BASE + path, method="DELETE")
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            return resp.status, resp.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        if exc.code == 404:
            return 404, None
        raise


def wait_for_moonraker(get_status, log, retry_attempts=RETRY_ATTEMPTS,
                        retry_delay=RETRY_DELAY_S, sleep=time.sleep) -> bool:
    """Polls a cheap, always-present database key (this project's own
    calibration-journal path is arbitrary; any namespace works, we only
    need "does Moonraker answer database requests at all") - bounded
    backoff, never raises."""
    last_err = None
    for attempt in range(1, retry_attempts + 1):
        try:
            get_status("/server/database/list")
            return True
        except Exception as exc:  # noqa: BLE001
            last_err = exc
            log(f"attempt {attempt}/{retry_attempts}: Moonraker database API "
                f"unavailable ({exc}) - retrying")
            if attempt < retry_attempts:
                sleep(retry_delay)
    log(f"Moonraker database API never became available after "
        f"{retry_attempts} attempts ({last_err})")
    return False


def get_item(get_status, key: str):
    """Returns the existing item's stored value, or None if the key
    genuinely does not exist yet. Raises TransportError for any other
    failure - a caller must never treat an ambiguous failure as "safe to
    create," since that could silently clobber something a real
    transport error merely hid from view."""
    path = f"/server/database/item?namespace=mainsail&key={key}"
    try:
        status, body = get_status(path)
    except Exception as exc:  # noqa: BLE001
        raise TransportError(str(exc)) from exc
    if status == 404:
        return None
    if body is None:
        raise TransportError("no response")
    try:
        parsed = json.loads(body)
    except Exception as exc:  # noqa: BLE001
        raise TransportError(f"malformed JSON: {exc}") from exc
    return parsed.get("result", {}).get("value")


def get_group(get_status, group_id: str):
    return get_item(get_status, f"macros.macrogroups.{group_id}")


def delete_item(delete, key: str) -> None:
    """Raises TransportError on anything but a clean delete or an
    already-absent key (404 - fine, idempotent)."""
    path = f"/server/database/item?namespace=mainsail&key={key}"
    try:
        status, _body = delete(path)
    except Exception as exc:  # noqa: BLE001
        raise TransportError(str(exc)) from exc
    if status not in (200, 404):
        raise TransportError(f"unexpected delete status {status}")


def migrate_legacy_group_ids(get_status, post, delete, log,
                              legacy_map: dict | None = None) -> dict:
    """Idempotent rename of every old underscore-style group ID to its
    hyphenated replacement, preserving the exact stored value (including
    any user edits to that group's macros/name/metadata) and touching
    nothing else - unrelated user-created groups are never enumerated or
    matched here at all, only the fixed, known legacy IDs.

    For each (old_id, new_id) pair:
      - old absent                          -> nothing to do (never
                                                shipped, or already
                                                migrated on a prior run)
      - old present, new absent             -> create new = old's value,
                                                verify, then delete old,
                                                verify deletion
      - old present, new present, equal     -> finish an interrupted
                                                prior migration: delete
                                                the now-redundant old key
      - old present, new present, different -> ambiguous (a real
                                                collision would mean
                                                something else wrote the
                                                new id first with
                                                different content) -
                                                touch neither, log it,
                                                let a human resolve it

    Returns a dict of old_id -> one of "migrated", "already_migrated",
    "not_present", "finished_interrupted", "ambiguous_left_untouched",
    "failed".
    """
    legacy_map = legacy_map if legacy_map is not None else LEGACY_GROUP_ID_MAP
    results = {}
    for old_id, new_id in legacy_map.items():
        try:
            old_value = get_group(get_status, old_id)
        except TransportError as exc:
            log(f"migration: could not check legacy group {old_id!r} ({exc}) - skipping")
            results[old_id] = "failed"
            continue

        if old_value is None:
            results[old_id] = "not_present"
            continue

        try:
            new_value = get_group(get_status, new_id)
        except TransportError as exc:
            log(f"migration: could not check target group {new_id!r} ({exc}) - "
                f"leaving legacy group {old_id!r} untouched this run")
            results[old_id] = "failed"
            continue

        if new_value is not None and new_value != old_value:
            log(f"migration: {new_id!r} already exists with content different "
                f"from legacy {old_id!r} - leaving both untouched (ambiguous, "
                "needs manual resolution)")
            results[old_id] = "ambiguous_left_untouched"
            continue

        if new_value is None:
            log(f"migration: renaming legacy group {old_id!r} -> {new_id!r}")
            try:
                post("/server/database/item", {
                    "namespace": "mainsail",
                    "key": f"macros.macrogroups.{new_id}",
                    "value": old_value,
                })
            except Exception as exc:  # noqa: BLE001
                log(f"migration: creating {new_id!r} failed ({exc}) - not "
                    f"deleting legacy {old_id!r}")
                results[old_id] = "failed"
                continue
            try:
                verify = get_group(get_status, new_id)
            except TransportError as exc:
                log(f"migration: could not verify {new_id!r} after creation "
                    f"({exc}) - not deleting legacy {old_id!r}")
                results[old_id] = "failed"
                continue
            if verify != old_value:
                log(f"migration: {new_id!r} verification mismatch after "
                    f"creation - not deleting legacy {old_id!r}")
                results[old_id] = "failed"
                continue

        # Either we just created new_id (verified equal to old_value), or
        # new_id already existed and was already equal to old_value
        # (interrupted prior run) - either way, old_id is now fully
        # redundant and safe to delete.
        try:
            delete_item(delete, f"macros.macrogroups.{old_id}")
        except TransportError as exc:
            log(f"migration: {new_id!r} is correct, but deleting legacy "
                f"{old_id!r} failed ({exc}) - will retry next run")
            results[old_id] = "failed"
            continue

        if old_value == new_value:
            log(f"migration: legacy group {old_id!r} was already migrated to "
                f"{new_id!r} on a prior, interrupted run - cleanup finished")
            results[old_id] = "finished_interrupted"
        else:
            log(f"migration: legacy group {old_id!r} fully migrated to {new_id!r}")
            results[old_id] = "migrated"

    return results


def seed_default_mode(get_status, post, log,
                       mode_key: str = MODE_KEY, default_mode: str = DEFAULT_MODE) -> str:
    """Sets macros.mode to `default_mode` ONLY if the key does not exist
    in the database at all yet. Mainsail's own Settings > Macros tab
    writes this key exclusively in response to an explicit user toggle
    (`gui/macros/saveSetting`, confirmed by reading the pinned v2.18.2
    bundle directly) - it is never written as a side effect of merely
    opening the app or a getter default. A missing key therefore reliably
    means "no one, ever, has touched this setting" - whether this is a
    brand new install or an existing one that predates NebulaOS shipping
    an opinion on it at all (this key was never seeded before 2026-09-06).
    Once any value is present, it is left alone forever - this is a
    one-time default, never a persistent "force expert" mechanism; a user
    who later chooses Simple in Settings stays on Simple across reboots
    and updates.

    Returns one of "seeded", "already_set", "failed".
    """
    try:
        existing = get_item(get_status, mode_key)
    except TransportError as exc:
        log(f"mode default: could not check {mode_key!r} ({exc}) - skipping this run")
        return "failed"

    if existing is not None:
        log(f"mode default: {mode_key!r} already set to {existing!r} - leaving it untouched")
        return "already_set"

    log(f"mode default: {mode_key!r} not set - seeding default {default_mode!r}")
    try:
        post("/server/database/item", {
            "namespace": "mainsail",
            "key": mode_key,
            "value": default_mode,
        })
    except Exception as exc:  # noqa: BLE001
        log(f"mode default: seeding {mode_key!r} failed ({exc})")
        return "failed"

    try:
        verify = get_item(get_status, mode_key)
    except TransportError as exc:
        log(f"mode default: could not verify {mode_key!r} after seeding ({exc})")
        return "failed"

    if verify != default_mode:
        log(f"mode default: {mode_key!r} verification mismatch after seeding "
            f"(got {verify!r}, expected {default_mode!r})")
        return "failed"

    log(f"mode default: {mode_key!r} seeded and verified as {default_mode!r}")
    return "seeded"


def read_marker(path: str):
    if not os.path.exists(path):
        return None
    try:
        with open(path) as f:
            return json.load(f)
    except Exception:  # noqa: BLE001
        return None


def write_marker_atomic(path: str, data: dict) -> None:
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    tmp = path + ".partial"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def _now() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def run(
    get_status=real_http_get_status,
    post=real_http_post_json,
    delete=real_http_delete_status,
    marker_path: str | None = None,
    log=print,
    groups: dict | None = None,
    legacy_map: dict | None = None,
    mode_key: str = MODE_KEY,
    default_mode: str = DEFAULT_MODE,
    retry_attempts: int = RETRY_ATTEMPTS,
    retry_delay: float = RETRY_DELAY_S,
    sleep=time.sleep,
) -> int:
    """Returns 0 on success (including "nothing new to do") or 1 on a
    safe, logged, non-fatal failure. Never raises. Idempotent by
    construction: every group is independently checked via its own
    stable DB key before any write, and an existing key (whether
    NebulaOS-seeded before or user-edited) is NEVER overwritten - a
    second run makes no changes once every group already exists, every
    legacy ID is already migrated, and macros.mode is already set."""
    marker_path = marker_path or MARKER_PATH
    groups = groups if groups is not None else DEFAULT_GROUPS

    if not wait_for_moonraker(get_status, log, retry_attempts, retry_delay, sleep):
        return 1

    migration_results = migrate_legacy_group_ids(get_status, post, delete, log, legacy_map)

    created = []
    already_present = []
    failed = []

    for group_id, definition in groups.items():
        try:
            existing = get_group(get_status, group_id)
        except TransportError as exc:
            log(f"could not check group {group_id!r} ({exc}) - skipping this "
                "group this run, not writing marker for it")
            failed.append(group_id)
            continue

        if existing is not None:
            log(f"group {group_id!r} already present in the mainsail namespace "
                "- leaving it untouched")
            already_present.append(group_id)
            continue

        log(f"group {group_id!r} not present - seeding default "
            f"({definition['name']!r}, {len(definition['macros'])} macros)")
        try:
            post("/server/database/item", {
                "namespace": "mainsail",
                "key": f"macros.macrogroups.{group_id}",
                "value": definition,
            })
        except Exception as exc:  # noqa: BLE001
            log(f"seeding group {group_id!r} failed ({exc}) - not marking it seeded")
            failed.append(group_id)
            continue

        try:
            verify = get_group(get_status, group_id)
        except TransportError as exc:
            log(f"could not re-verify group {group_id!r} after seeding ({exc}) - "
                "not marking it seeded (creation may or may not have actually "
                "succeeded; never trust HTTP status alone)")
            failed.append(group_id)
            continue

        if verify != definition:
            log(f"group {group_id!r} seeding POST reported success but "
                "verification found different content afterward - not "
                "marking it seeded")
            failed.append(group_id)
            continue

        log(f"group {group_id!r} created and verified")
        created.append(group_id)

    mode_result = seed_default_mode(get_status, post, log, mode_key, default_mode)

    migration_failed = [k for k, v in migration_results.items()
                        if v in ("failed", "ambiguous_left_untouched")]

    write_marker_atomic(marker_path, {
        "checked_at": _now(),
        "created": created,
        "already_present": already_present,
        "failed": failed,
        "migration": migration_results,
        "mode_default": mode_result,
    })
    log(f"marker written ({marker_path}): created={created} "
        f"already_present={already_present} failed={failed} "
        f"migration={migration_results} mode_default={mode_result}")

    return 1 if (failed or migration_failed or mode_result == "failed") else 0


if __name__ == "__main__":
    sys.exit(run())
