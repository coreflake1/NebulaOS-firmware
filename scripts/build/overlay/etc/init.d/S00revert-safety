#!/bin/sh
#
# Boot-time OTA marker policy (FIRMWARE.md sec 21/22). Runs before every
# other init script, even syslogd/klogd.
#
# HISTORY: this script used to unconditionally write "ota:kernel" (stock
# slot) on every boot, so that any failure before S99confirm-good would cause
# the next reboot to land on stock automatically. That automatic stock
# fallback was REMOVED in Phase 1.8B because booting the stock Creality
# slot auto-flashes the MCU with old Creality firmware, destroying the
# qualified native GD32F303 MCU build. The risk of silently bricking the
# MCU outweighs the convenience of automatic rollback.
#
# CURRENT POLICY: this script is a deliberate NO-OP. The OTA marker stays
# on whatever value it already has (normally "ota:kernel2", i.e. NebulaOS).
# If Klipper fails to start, the device stays on NebulaOS and requires
# MANUAL recovery via SSH or USB (see docs/DEVELOPER_RECOVERY.md). This is
# safer than an automatic stock boot that destroys the MCU firmware.
#
# The ota_marker.sh library is still sourced so that write_ota_marker
# remains available in this environment for manual recovery commands.

. /etc/ota_marker.sh

case "$1" in
	start)
		echo "S00revert-safety: automatic stock fallback DISABLED (MCU safety - Phase 1.8B). Marker unchanged; manual recovery required on failure."
		;;
	*)
		;;
esac
exit 0
